<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane"
            prefHeight="720.0"
            prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.carrental.MyBookingsController"
            stylesheets="@dashboard.css">

    <children>
        <VBox spacing="30.0" alignment="CENTER"
              AnchorPane.topAnchor="40.0"
              AnchorPane.bottomAnchor="40.0"
              AnchorPane.leftAnchor="80.0"
              AnchorPane.rightAnchor="80.0">

            <!-- Page Title -->
            <Label text="My Bookings And Returns"
                   style="-fx-font-size: 36px;
                          -fx-font-weight: bold;"
                   styleClass="page-title"/>

            <!-- Bookings Table -->
            <TableView fx:id="bookingsTable" prefHeight="500.0">
                <columns>
                    <TableColumn fx:id="imageCol" prefWidth="90.0" text="" />
                    <TableColumn fx:id="carIdCol" text="Car ID" prefWidth="100.0"/>
                    <TableColumn fx:id="modelCol" text="Model" prefWidth="200.0"/>
                    <TableColumn fx:id="fromCol" text="From Date" prefWidth="130.0"/>
                    <TableColumn fx:id="toCol" text="To Date" prefWidth="130.0"/>
                    <TableColumn fx:id="costCol" text="Total Cost" prefWidth="120.0"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="110.0"/>
                    <TableColumn fx:id="returnFuelCol" text="Return Fuel %" prefWidth="120.0"/>
                    <TableColumn fx:id="returnConditionCol" text="Return Condition" prefWidth="180.0"/>
                </columns>
            </TableView>

            <!-- Back Button -->
            <Button text="BACK TO DASHBOARD"
                    onAction="#handleBack"
                    prefHeight="55.0"
                    prefWidth="300.0"
                    styleClass="logout-btn"/>
        </VBox>
    </children>
</AnchorPane>
