<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
            prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.carrental.forget_passwordController">

    <VBox alignment="CENTER" spacing="25"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          style="-fx-padding: 40 80 40 80;">

        <Label text="Reset Your Password"
               style="-fx-font-size: 42px; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <!-- Glass card -->
        <VBox fx:id="card" spacing="18" alignment="CENTER" prefWidth="460"
              style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 25; -fx-border-color: rgba(255,255,255,0.35); -fx-border-width: 1.2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 30, 0.3, 0, 10); -fx-padding: 35;">

            <!-- Step indicator -->
            <Label fx:id="stepLabel" text="Step 1 of 3"
                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.50);"/>

            <!-- ===== STEP 1: Username + Email ===== -->
            <VBox fx:id="step1Box" spacing="14" alignment="CENTER" prefWidth="380">

                <Label text="Enter your username to verify your identity"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);"/>

                <Label text="Username" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           prefHeight="44" maxWidth="350"
                           style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-background-radius: 12;"/>

                <Button fx:id="sendOtpBtn" text="Send Verification Code" onAction="#handleSendOtp"
                        prefWidth="280" prefHeight="50"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- ===== STEP 2: OTP ===== -->
            <VBox fx:id="step2Box" spacing="14" alignment="CENTER" prefWidth="380" visible="false" managed="false">

                <Label fx:id="otpMessage" text=""
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.70); -fx-wrap-text: true; -fx-text-alignment: center;"/>

                <Label text="Verification Code" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                <TextField fx:id="otpField" promptText="Enter 6-digit code"
                           prefHeight="44" maxWidth="250"
                           style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-background-radius: 12; -fx-font-size: 20px;"/>

                <Button fx:id="verifyOtpBtn" text="Verify Code" onAction="#handleVerifyOtp"
                        prefWidth="250" prefHeight="50"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- ===== STEP 3: New Password ===== -->
            <VBox fx:id="step3Box" spacing="14" alignment="CENTER" prefWidth="380" visible="false" managed="false">

                <Label text="Create a strong new password"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);"/>

                <Label text="New Password" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                <PasswordField fx:id="newPasswordField" promptText="Enter new password"
                               prefHeight="44" maxWidth="350"
                               style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-background-radius: 12;"/>

                <Label text="Confirm Password" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password"
                               prefHeight="44" maxWidth="350"
                               style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-background-radius: 12;"/>

                <Button fx:id="resetBtn" text="Reset Password" onAction="#handleResetPassword"
                        prefWidth="280" prefHeight="50"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- Back button (always visible) -->
            <Button text="Back to Login" onAction="#handleBack"
                    prefWidth="180" prefHeight="42"
                    style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.70); -fx-font-size: 13px; -fx-background-radius: 12; -fx-cursor: hand;"/>
        </VBox>

    </VBox>
</AnchorPane>
