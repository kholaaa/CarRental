<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane"
            prefHeight="720.0"
            prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.carrental.generate_reportController"
            stylesheets="@dashboard.css">

    <children>
        <VBox alignment="CENTER" spacing="20.0"
              styleClass="glass-card"
              style="-fx-padding: 30;"
              AnchorPane.topAnchor="25.0"
              AnchorPane.bottomAnchor="25.0"
              AnchorPane.leftAnchor="50.0"
              AnchorPane.rightAnchor="50.0">

            <!-- Page Title -->
            <Label text="Rental Report"
                   styleClass="page-title"
                   style="-fx-font-size: 32px;"/>

            <!-- Report Table -->
            <TableView fx:id="reportTable" prefHeight="400.0" prefWidth="1150.0"
                       styleClass="beautiful-table">
                <columns>
                    <TableColumn fx:id="customerNameCol" text="Customer Name" prefWidth="150.0"/>
                    <TableColumn fx:id="carCol" text="Car ID" prefWidth="70.0"/>
                    <TableColumn fx:id="startDateCol" text="Start Date" prefWidth="100.0"/>
                    <TableColumn fx:id="returnDateCol" text="Return Date" prefWidth="100.0"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="80.0"/>
                    <TableColumn fx:id="conditionCol" text="Vehicle Condition" prefWidth="250.0"/>
                    <TableColumn fx:id="fuelCol" text="Fuel %" prefWidth="70.0"/>
                    <TableColumn fx:id="daysCol" text="Days" prefWidth="60.0"/>
                    <TableColumn fx:id="costCol" text="Total Cost (PKR)" prefWidth="130.0"/>
                </columns>
            </TableView>

            <!-- AI Revenue Forecast (below the table) -->
            <Label fx:id="forecastLabel"
                   text="Computing revenue forecast..."
                   wrapText="true"
                   style="-fx-font-size: 15px; -fx-text-fill: #81c784; -fx-font-weight: bold; -fx-alignment: center;"/>

            <!-- Back Button -->
            <Button text="BACK TO DASHBOARD"
                    onAction="#handleBack"
                    prefHeight="55.0"
                    prefWidth="250.0"
                    styleClass="btn-back"/>
        </VBox>
    </children>
</AnchorPane>
