<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.carrental.TermsConditionsController"
            stylesheets="@dashboard.css">

    <children>
        <ImageView fitWidth="1280.0" fitHeight="720.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@pics/llg.png"/>
            </image>
        </ImageView>

        <Label prefWidth="1280.0" prefHeight="720.0"
               style="-fx-background-color: rgba(0,0,0,0.55);"/>

        <VBox alignment="CENTER" spacing="0"
              maxWidth="820.0" maxHeight="560.0"
              AnchorPane.topAnchor="80.0" AnchorPane.bottomAnchor="80.0"
              AnchorPane.leftAnchor="230.0" AnchorPane.rightAnchor="230.0"
              styleClass="glass-card"
              style="-fx-background-color: white;">

            <Region prefHeight="4.0" maxWidth="820.0"
                    style="-fx-background-color: linear-gradient(to right, #e64a19, #ff8a50, #e64a19); -fx-background-radius: 24 24 0 0;"/>

            <Label fx:id="termsTitleLabel"
                   style="-fx-text-fill: #1a1a1a; -fx-font-size: 30px; -fx-font-weight: bold; -fx-padding: 28 40 8 40;"/>

            <Region prefHeight="1.0" maxWidth="720.0"
                    style="-fx-background-color: rgba(0,0,0,0.10); -fx-background-radius: 1;"/>
            <Region prefHeight="12.0"/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefHeight="340.0" prefWidth="740.0"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 30;">

                <Label fx:id="termsContentLabel"
                       wrapText="true"
                       prefWidth="700.0"
                       style="-fx-text-fill: #2c2c2c; -fx-font-size: 15px; -fx-line-spacing: 6;"/>
            </ScrollPane>

            <Region prefHeight="20.0"/>

            <HBox alignment="CENTER" spacing="20.0" prefWidth="740.0"
                  style="-fx-padding: 0 40 28 40;">

                <Button fx:id="backButton"
                        text="BACK TO DASHBOARD"
                        onAction="#handleBack"
                        prefHeight="44.0" prefWidth="220.0"
                        styleClass="btn btn-back"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
