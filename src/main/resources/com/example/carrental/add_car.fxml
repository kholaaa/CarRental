<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.carrental.add_carController"
            stylesheets="@dashboard.css">

    <children>

        <VBox alignment="CENTER" spacing="18.0"
              styleClass="glass-card"
              style="-fx-padding: 40;"
              prefWidth="600.0" prefHeight="620.0"
              AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0">

            <Label text="&#x2795;  Add New Car"
                   styleClass="page-title"
                   style="-fx-font-size: 32px;"/>

            <TextField fx:id="carIdField" promptText="Car ID (unique number)" prefHeight="50.0" styleClass="glass-text-field"/>
            <TextField fx:id="modelField" promptText="Model (e.g. Corolla)" prefHeight="50.0" styleClass="glass-text-field"/>
            <TextField fx:id="typeField" promptText="Type (e.g. Sedan, SUV)" prefHeight="50.0" styleClass="glass-text-field"/>
            <TextField fx:id="colourField" promptText="Colour (e.g. Black, Silver)" prefHeight="50.0" styleClass="glass-text-field"/>
            <TextField fx:id="priceField" promptText="Price per Day (PKR)" prefHeight="50.0" styleClass="glass-text-field"/>

            <Label fx:id="suggestedPriceLabel" wrapText="true" alignment="CENTER" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #7CFC9A;"/>

            <HBox alignment="CENTER" spacing="40.0" prefHeight="80.0">
                <Button text="ADD CAR"
                        onAction="#handleAddCar"
                        prefHeight="60.0" prefWidth="220.0"
                        styleClass="btn btn-submit"/>

                <Button text="BACK"
                        onAction="#handleBack"
                        prefHeight="60.0" prefWidth="260.0"
                        styleClass="btn btn-back"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
